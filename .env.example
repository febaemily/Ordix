# ==============================================================================
# ORDIX Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this template to create your local .env file:
#      PowerShell: Copy-Item .env.example .env
#      Bash/Linux: cp .env.example .env
# 2. Replace the placeholder below with your real Google Gemini API key.
# 3. Obtain a Gemini API key at: https://aistudio.google.com/app/apikey
# ==============================================================================

# Required: Google Gemini API Key (Replace with your actual key in .env)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Gemini Model Selection (Defaults to gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash

# Optional: Local Server Network Configuration
HOST=127.0.0.1
PORT=8000
